<?xpacket begin="Ôªø" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/"><rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
<rdf:Description rdf:about="" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:xmp="http://ns.adobe.com/xap/1.0/"
 xmlns:pdf="http://ns.adobe.com/pdf/1.3/" xmlns:xmpRights="http://ns.adobe.com/xap/1.0/rights/" xmlns:xmpMM="http://ns.adobe.com/xap/1.0/mm/">
<dc:title><rdf:Alt><rdf:li xml:lang="x-default">RedTail Across Five Vectors: One Campaign Observed on a T-Pot Honeypot, September 2026</rdf:li></rdf:Alt></dc:title>
<dc:creator><rdf:Seq><rdf:li>Thadd√§us Bischoff</rdf:li></rdf:Seq></dc:creator>
<dc:description><rdf:Alt><rdf:li xml:lang="x-default">A single T-Pot honeypot recorded one continuous RedTail campaign between 2026-09-16 and 2026-09-28 on five vectors: SSH, Telnet, HTTP, HTTPS and the Docker API. The report documents the evidence for one operation, the Telnet infection path, the detection gap under the ET Open ruleset, and recommendations for defenders.</rdf:li></rdf:Alt></dc:description>
<dc:subject><rdf:Bag><rdf:li>RedTail</rdf:li><rdf:li>honeypot</rdf:li><rdf:li>T-Pot</rdf:li><rdf:li>cryptominer</rdf:li><rdf:li>threat intelligence</rdf:li><rdf:li>indicators of compromise</rdf:li></rdf:Bag></dc:subject>
<dc:rights><rdf:Alt><rdf:li xml:lang="x-default">Copyright (c) 2026 Thadd√§us Bischoff. Licensed under CC BY 4.0 (https://creativecommons.org/licenses/by/4.0/).</rdf:li></rdf:Alt></dc:rights>
<dc:date><rdf:Seq><rdf:li>2026-10-13</rdf:li></rdf:Seq></dc:date>
<dc:language><rdf:Bag><rdf:li>en-US</rdf:li></rdf:Bag></dc:language>
<dc:source>https://github.com/TBjunior/redtail-analysis</dc:source>
<dc:type><rdf:Bag><rdf:li>Text</rdf:li></rdf:Bag></dc:type>
<xmp:CreateDate>2026-10-13T00:00:00Z</xmp:CreateDate><xmp:ModifyDate>2026-10-13T00:00:00Z</xmp:ModifyDate><xmp:MetadataDate>2026-10-13T00:00:00Z</xmp:MetadataDate>
